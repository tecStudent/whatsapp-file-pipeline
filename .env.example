# Application
APP_NAME=WhatsApp File Pipeline
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# Local infrastructure
DATABASE_URL=postgresql+psycopg://whatsapp:whatsapp@postgres:5432/whatsapp_pipeline
REDIS_URL=redis://redis:6379/0
PROCESSING_STATUS_TTL_SECONDS=604800

# Google Drive OAuth
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Oracle Cloud Infrastructure
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET_NAME=

# File validation
MAX_FILE_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
